APP_NAME=order-support-agent
APP_ENV=local
LOG_LEVEL=INFO

# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=orders
POSTGRES_PORT=5433

# Example shape (replace USER and PASSWORD with your .env values):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/orders
DATABASE_URL=

# Add provider keys when LLM work starts.
# OPENAI_API_KEY=
